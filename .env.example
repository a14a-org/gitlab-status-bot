# -------------------------
# SLACK APP CONFIGURATION
# -------------------------

# Your app's bot token (starts with "xoxb-")
# Found in your app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=

# Your app-level token for Socket Mode (starts with "xapp-")
# Found in your app's "Basic Information" page under "App-Level Tokens".
# Requires the "connections:write" scope.
SLACK_APP_TOKEN=

# Your app's signing secret
# Found in your app's "Basic Information" page under "App Credentials".
SLACK_SIGNING_SECRET=

# The ID of the Slack channel where the bot will post messages (e.g., C12345678)
SLACK_CHANNEL_ID=

# --------------------------
# GITLAB API CONFIGURATION
# --------------------------

# A secure, random string you create. This is used to verify that webhooks
# are actually coming from your GitLab project.
GITLAB_WEBHOOK_SECRET=

# A GitLab Personal Access Token with "read_api" scope.
# Create this in your GitLab user profile settings.
GITLAB_API_TOKEN=

# The numeric ID of your GitLab project.
# Found on your project's main page.
GITLAB_PROJECT_ID=

# The base URL of your GitLab instance.
# For GitLab.com, this is https://gitlab.com
GITLAB_BASE_URL=https://gitlab.com

# --------------------------
# BEHAVIOUR TUNING (OPTIONAL)
# --------------------------

# Branches that always get a top-level card in the channel. Any other branch
# that actually deploys is picked up by DEPLOY_STAGE_PATTERN below, so this
# usually only needs your default branch.
DEPLOY_BRANCHES=main,master

# Any pipeline containing a stage matching this pattern gets a card, whatever
# its branch (e.g. deploy_acc, deploy_prod, deploy-staging).
DEPLOY_STAGE_PATTERN=^deploy

# Also post a card when a non-deploying branch fails.
POST_NON_DEPLOY_FAILURES=false

# Coalescing window for progress updates, in milliseconds. Failures and
# terminal pipeline states render immediately regardless.
UPDATE_DEBOUNCE_MS=4000

# Age at which commit state is deleted from Firestore.
STATE_TTL_DAYS=14

# --------------------------
# ERROR REPORTING CONFIGURATION (OPTIONAL)
# --------------------------

# Slack channel ID for error reports (optional)
# If not set, will use SLACK_CHANNEL_ID
ERROR_REPORT_CHANNEL_ID=

# Authentication token for Cloud Scheduler (optional but recommended)
# Create a random string to secure the /reports/errors endpoint
SCHEDULER_AUTH_TOKEN=
